# Copy to .env.local (gitignored) and fill in. Never commit real keys.

# Free key from https://aistudio.google.com/apikey — restrict it to the
# "Generative Language API" (unrestricted keys are no longer accepted).
GEMINI_API_KEY=

# Optional model overrides (defaults: stable free-tier models as of Nov 2026).
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: require this code before the AI routes respond (set it if you deploy).
# AI_ACCESS_CODE=

# --- Neon (written by `neon deploy` / `neon env pull`; do not hand-edit) ---
# DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH, NEON_BRANCH_ID, NEON_FUNCTION_HOST_SUFFIX,
# NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_ENDPOINT_URL_S3, AWS_REGION, NEON_AI_GATEWAY_TOKEN, NEON_AI_GATEWAY_BASE_URL,
# NEON_REALTIME_URL, NEON_REALTIME_SECRET

# Session-cookie secret for Neon Auth in Next.js (yours, not Neon's): openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Optional: route the AI interviewer through the Neon AI Gateway instead of Google AI Studio.
# Needs AI Gateway credits on the Neon org. Model IDs use dashes on the gateway.
# AI_PROVIDER=neon
# NEON_AI_MODEL=gemini-3-8-flash
# NEON_AI_FALLBACK_MODEL=gemini-3-5-flash-lite
